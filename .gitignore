# ---------------------------------------------------------------------------
# Secrets — never commit these. See CLAUDE.md.
# ---------------------------------------------------------------------------
secrets.yaml
secrets.example.yaml.local
.env
*.pem
*.key
*_credentials.json

# Node-RED stores encrypted credentials alongside flows
flows_cred.json
.config.*.json

# Keep sanitized templates trackable
!secrets.example.yaml
!*.example

# ---------------------------------------------------------------------------
# Home Assistant runtime state — regenerated by HA, not source
# ---------------------------------------------------------------------------
.storage/
.cloud/
.uuid
.HA_VERSION
deps/
tts/
image/
backups/
# sync_config.py --backup writes here. Distinct from HA's own backups/ above,
# and holds pre-overwrite copies of live config — never source, never committed.
.backups/
known_devices.yaml
ip_bans.yaml

# Recorder database
home-assistant_v2.db
home-assistant_v2.db-shm
home-assistant_v2.db-wal
*.db-journal

# Logs
*.log
*.log.*
home-assistant.log*
OZW_Log.txt
zwcfg_*.xml
zwscene.xml

# HACS-managed frontend resources are downloaded, not authored here.
# Integrations under custom_components/ that HACS installs should also be
# left out — add them individually as you install them.
**/www/community/
**/custom_components/hacs/

# ---------------------------------------------------------------------------
# Python (custom components, pyscript, AppDaemon apps)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.eggs/
build/
dist/

# Test + lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------------------
# AppDaemon / Node-RED
# ---------------------------------------------------------------------------
**/appdaemon/compiled/
nodered/node_modules/
node_modules/
.node-red/

# ---------------------------------------------------------------------------
# Editors and OS cruft
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
